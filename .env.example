# Supabase Configuration (Required for Online Database, Auth & Storage)
# Copy this file to .env and replace with your Supabase project credentials
# NEVER put your Supabase service_role key here! Only use the public anon key.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key-here
